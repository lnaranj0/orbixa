# Copy to .env.testing (gitignored) and fill the passwords.
# Host, port and database are also forced in phpunit.xml so tests can never
# target the development database (port 5433 / database orbixa).
APP_ENV=testing
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=orbixa_test
DB_USERNAME=orbixa_app
DB_PASSWORD=
DB_MIGRATOR_USERNAME=orbixa_migrator
DB_MIGRATOR_PASSWORD=
DB_MIGRATOR_DATABASE=orbixa_test
DB_RELAY_USERNAME=orbixa_relay
DB_RELAY_PASSWORD=
DB_ALLOW_DESTRUCTIVE_COMMANDS=false
